def safe_int(val: Any, default: int = 90) -> int:
    """摰匧���㟲�啗蓮�ｇ��脫迫憭扳芋�见銁JSON銝剖��箸筑�寞㺭�硋�蝚虫葡��㺭撖潸稲 >= 瘥磰��仿�"""
    try:
        return int(float(str(val).strip()))
    except (ValueError, TypeError):
        return default

def get_system_directive(planner: str) -> str:
    """�寞旿閫��嚗㇊lanner嚗匧𢆡����鞟鸌撘��批�撖潘��𦦵�蝖祉����蝵�"""
    directives = {
        "�舐��箏�": "the biological, molecular, and pharmacological mechanisms of the drug or treatment",
        "�刻晓�寞�銝𡡞�隡滨�敹�": "the clinical dosing regimens, safety boundaries, and drug-drug/disease contraindications",
        "銝游�銵函緵": "the clinical signs, symptoms, and disease progression features",
        "霂𦠜鱏銝𡡞��怨���": "the diagnostic criteria, laboratory/imaging findings, and differential diagnosis logic",
        "銝游��埈�": "the clinical efficacy, therapeutic outcomes, and patient response parameters",
        "銝滩��滚�": "the side effects, adverse events, toxicological mechanisms, and safety monitoring"
    }
    return directives.get(planner, f"the clinical rationale, evidence synthesis, and medical logic related to {planner}")

