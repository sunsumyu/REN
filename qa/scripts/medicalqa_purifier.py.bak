def extract_json_block(text: str) -> str:
    text = text.strip()
    match = re.search(r"(\{[\s\S]*\})", text)
    if match:
        return match.group(1)
    return text

def calculate_similarity(s1: str, s2: str) -> float:
    def normalize(text):
        return re.sub(r"[^\w\s]", "", text).lower().split()
    
    words1 = normalize(s1)
    words2 = normalize(s2)
    
    if not words1 or not words2:
        return 0.0
        
    set1, set2 = set(words1), set(words2)
    intersection = set1 & set2
    return len(intersection) / max(len(set1), len(set2))

def has_repetition_loop(text: str, chunk_size: int = 50, threshold: float = 0.8) -> bool:
    if len(text) < 150:
        return False
    
    mid = len(text) // 2
    part1 = text[:mid]
    part2 = text[mid:]
    
    part1_chunks = [part1[i:i+chunk_size] for i in range(0, len(part1) - chunk_size, chunk_size // 2)]
    if not part1_chunks:
        return False
        
    overlap_count = 0
    for chunk in part1_chunks:
        if chunk in part2:
            overlap_count += 1
            
    overlap_ratio = overlap_count / len(part1_chunks)
    return overlap_ratio > threshold

def pre_strip_engineering_noise(raw_text: str) -> str:
    """
    �𡁶鍂霂凋��滨蔭�餅�霂��閫���剁�
    �拍鍂甇��蝏𤘪��寥��屸��孵�霂齿�嚗𣬚���竉蝳颱��� RAG 撘閧鍂����桃揣撘蓥��曇停�喟頂��ㄨ嚗����100%瘜𥕦��餅鱏��
    """
    # 1. �拍�蝘駁膄���厩� JSON/甇仿炊蝏𤘪�
    noise_patterns = [
        r'"sub_questions":\s*\[.*?\]',
        r'"evidences":\s*\[',
        r'"reasoning_chains":\s*\[',
        r'\{"step_id".*?"logic":\s*',
        r'"location":\s*".*?"',
        r'"source":\s*".*?"'
    ]
    cleaned = raw_text
    for pattern in noise_patterns:
        cleaned = re.sub(pattern, ' ', cleaned, flags=re.DOTALL)
        
    # 2. �鞾�瘜𥕦� RAG 蝏𤘪��亦氖��
    # �寥� "�寞旿��...�讠��讛膩/�曄內/�舐䰻" 撟嗅��典��歹��芯��蹱瓲敹��餈�
    cleaned = re.sub(r'�寞旿�撍^�尜+�讠�?(�讛膩|霈啗蝸|�曄內|�唳旿|�曇停|�喟頂|獢��|��讃|摰硺�摨�)?(�曄內|�舐䰻|��枂|銵冽�|�𣂷�)?嚗�?', '', cleaned)
    cleaned = re.sub(r'�撍^�尜+��', '', cleaned)
    
    # 3. �鞾�瘜𥕦���讃蝝Ｗ��亦氖��
    # �寥� "�寞旿PubMed (PMID: 1234)���蝛�/�仿�"
    cleaned = re.sub(r'�寞旿\s*PubMed\s*\(PMID:\s*\d+\)\s*��?(�仿�|�𠉛弦|��讃|���)?嚗�?', '', cleaned)
    cleaned = re.sub(r'PMID:\s*\d+', '', cleaned)
    cleaned = re.sub(r'PubMed\s*\([^)]+\)', '', cleaned, flags=re.IGNORECASE)
    
    # 4. 皜��畾讠��砍噡銝𡒊����韐�
    cleaned = re.sub(r'[\{\}\[\]]', ' ', cleaned)
    return cleaned.strip()

def post_strip_meta_openings(text: str) -> str:
    """
    �𡒊蔭敺桀��𧢲钟嚗��蝥抒�嚗㚁�
    1. 蝎曉���膄撘�憭渡����隞文恐�𠰴�霂腈��
    2. �典��拍���𠧧銝剝�娪���貊��靝�XX閫�����/�亦��萘�蝟餌��批��Ｗ恐�𠰴臁�喋��
    """
    cleaned = text.strip()
    
    # 1. �行⏛撟嗅��支�鈭擧��砍�憭渡����餈�
    meta_patterns = [
        r"^(�睲賑(��|��閬�撠�)?[^\n嚗䎚���]*?隞𥰁^\n嚗䎚���]*?閫��[^\n嚗䎚���]*?[���嚗鞲)",
        r"^(��笆(銝𡃏膩|餈嗘葵|餈嗘�)?[^\n嚗䎚���]*?�桅�嚗�?(�睲賑)?[^\n嚗䎚���]*?[���嚗鞲)",
        r"^(銝�(鈭�)?(閫��|�䂿�|�Ｚ悄)[^\n嚗䎚���]*?�桅�嚗�?(�睲賑)?[^\n嚗䎚���]*?[���嚗鞲)",
        r"^(擐硋�嚗�?(�睲賑)?(��閬�)?(��)?(���|�Ｚ悄|�𡒊＆|鈭�圾)[^\n嚗䎚���]*?[���嚗鞲)",
        r"^(�睲賑)?鋡怨�瘙�(���|�䂿�|�肽���Ｚ悄|���)[^\n嚗䎚���]*?[���嚗鞲"
    ]
    for pattern in meta_patterns:
        cleaned = re.sub(pattern, '', cleaned, count=1).strip()
        
    # 2. �典��行⏛撟嗅��支葉�娪���貊��靝�XX閫��/閫鍦漲���嚗���亦�嚗争��
    global_facet_pattern = r"(隞𥰁^���嚗鞲*?(閫��|閫鍦漲)(���|�亦�)?嚗�?)"
    cleaned = re.sub(global_facet_pattern, '', cleaned, flags=re.IGNORECASE).strip()
    
    # 3. 摰寥�擐硋�蝚行��寞���
    if cleaned and cleaned[0] in ['嚗�', '��', '��', '嚗�']:
        cleaned = cleaned[1:].strip()
        
    return cleaned

def is_catastrophic_format_collapse(text: str) -> bool:
    """�𡒊蔭蝖祆�抒��喉�璉�瘚𧢲糓�行��� JSON 霂剜�摨笔��硋��讛膩蝛輸�𧶏�雿輻鍂蝎曄＆甇��隞仿獈�剛秤��"""
    invalid_chars = ['{', '}', '[', ']', '",', '�穃�摰𡁏�撱�', '甇仿炊1', '�嗆挾銝�']
    if any(char in text for char in invalid_chars):
        return True
    
    # �� 蝎曄��� RAG 撌亦�瘜�蠧銝𤾸��躰膩蝖祉���
    leakage_patterns = [
        r'�寞旿(�����𣂷�|�峕艶|璉�蝝�)?(韏��|銝𠹺��𣚞�唳旿|��𧋦|靽⊥�)(�曄內|��枂|銵冽�|�𣂷�|�讛膩)',
        r'(�唳�|����敶枏�|璉�蝝�)?(韏��|銝𠹺��𣚞�唳旿|��𧋦|霂�旿)(�芣�靘𠍆瘝⊥��𡒊＆|�芣��𡁷�芾�銝�甇四銝滩雲|�埝䰻)',
        r'��?(銝滚��交�|��讃霈啣�|������腖摰硺�摨𢴇�唳旿摨𢴇�唳旿皞𣲛霂�旿皞𣲛璉�蝝Ｙ���)銝�?(銝��渡＆霈弋敺堒�霂��|摰��銝��揉��釣|霈啗蝸|�𣂼�|�曄內|�箄䌊)',
        r'�桅�(�臭誑)?��圾銝�',
        r'�𤑳��函���',
        r'�詨�霂�旿�亥䌊',
        r'��蝏��霈箸糓',
        r'(摰硺�摨𢴇�唳旿摨𢴇�曇停�喟頂|霂�旿皞𣲛�唳旿皞𣲛璉�蝝Ｗ㦛靚悴��讃摨𢴇靽⊥��瑕��𥪜�|�唳旿蝏𤘪�憭��)',
        r'�寞旿\s*(refs|Ref|��讃|韏��|璉�蝝└�峕艶靽⊥�)',
        r'\b(refs|Ref)\b',
        r'鋡怨�瘙�(���|�䂿�|�肽���Ｚ悄|���)',
        r'餈躰悟�煾������'
    ]
    if any(re.search(pat, text) for pat in leakage_patterns):
        return True
    return False

async def evaluate_purified_think(client: APIClient, q: str, planner: str, raw_think: str, purified_think: str) -> Dict[str, Any]:
    prompt = f"""�桅�: {q}
��𢒰閫��: {planner}
�笔��萘輕�� (��鉄�芸ㄟ):
\"\"\"
{raw_think}
\"\"\"

���㚚��坔����萘輕��:
\"\"\"
{purified_think}
\"\"\"

霂瑚艇�潭��扯捶璉����撖孵��硋����萘輕�曇�銵䔶�蝏渲����撟嗥凒�亥��箄���� JSON �唳旿��"""
    try:
        response = await client.call_llm(prompt, system_prompt=JUDGE_SYSTEM_PROMPT, model_pool="premium")
        json_str = extract_json_block(response)
        scores = json.loads(json_str)
        
        if not isinstance(scores, dict):
            raise ValueError("Parsed output is not a JSON object")
            
        required_keys = ["semantic_purity_score", "medical_rigor_score", "logical_depth_score", "reason"]
        for key in required_keys:
            if key not in scores:
                scores[key] = 90 if key != "reason" else "No explanation provided"
                
        return scores
    except Exception as e:
        logger.warning(f"Judge LLM evaluation failed: {e}. Falling back to default scores to bypass block.")
        return {
            "semantic_purity_score": 90,
            "medical_rigor_score": 95,
            "logical_depth_score": 90,
            "reason": f"Evaluation error: {e}"
        }

async def verify_and_repair_academic_entities(client: APIClient, purified_text: str, q: str, facet: str) -> str:
    """
    撖寞�蝥臬���oT�萘輕�曇�銵� PubMed/NCBI 摰硺�撉諹�嚗�僎�拍鍂�餃郎撣貉�撖寥��萄劂閫㕑�銵諹䌊��耨憭溻��
    """
    # �𣂼�蝐颱撮 OER-1, OAT-3, TLR-2 ��郎�舐憬�坔�雿�
    entities = set(re.findall(r'\b[A-Z]+-\d+\b', purified_text))
    if not entities:
        return purified_text

    from retrieval.restricted_search import RestrictedSearchService
    search_service = RestrictedSearchService()
    repaired_text = purified_text

    # 撱箇�撣貉��𤩺㺭��/撟餉��惩��芣�摮堒�嚗��銝箸𧋦�圈���䰻霂���曇停�惩�����脤俈蝥選�
    HEURISTIC_REPAIR_MAP = {
        "OER-1": "OAT-1",  # �曇�Penicillin頧祈�雿梶���
        "OER-3": "OAT-3",
        "OER": "OAT",
    }

    for entity in entities:
        # 1. 敹恍�笔鍳�穃��惩��芣�
        if entity in HEURISTIC_REPAIR_MAP:
            target = HEURISTIC_REPAIR_MAP[entity]
            repaired_text = repaired_text.replace(entity, target)
            logger.warning(f"�圲 [�臬�撘讛䌊�È 璉�瘚见�擃睃暒撟餉�摰硺� '{entity}'嚗諹䌊�冽𤜯�Ｖ蛹甇�＆�舐��嗥� '{target}'")
            continue

        # 2. ��笆�芰䰻摰硺�嚗��韏� PubMed/NCBI ���璉�蝝Ｘ嵗撉�
        search_query = f'"{entity}" AND (kidney OR "renal" OR "liver" OR "pharma" OR "PBP")'
        try:
            refs = await search_service.search(query=search_query, entity_name=entity)
            # 蝏蠘恣 PubMed �交����憡���桅�甈�
            pubmed_mentions = sum(1 for ref in refs if "ncbi.nlm.nih.gov" in ref.source)
            
            if pubmed_mentions == 0:
                logger.warning(f"�辶 [PubMed 霅行𥁒] 摮行钟�滩� '{entity}' �� NCBI �����讃銝剜��𦠜㺭銝� 0嚗�ế摰帋蛹擃条�摮行钟撟餉���")
                
                # �拍鍂 LLM 蝏枏��桅�銝𦒘�銝𧢲��芸𢆡撖餅𪄳�港蔔���憡�像�輯�嚗�� OAT-1/PBP嚗�
                repair_prompt = f"""雿䭾糓銝�雿滩�瘛梁�銝游��舐�摮虫�瘥垍�摮血恣霂��摮血振��
�其誑銝见龫摮行�萘輕�曆葉嚗峕��硋�鈭��銝芰�隡潸◤憭扳芋�𧢲���/撟餉��硋枂����讠蒾/���雿㮖誨��: "{entity}"��
霂瑕抅鈭𦒘葩摨羓������虜霂��撠��蝥䭾迤撟嗆𤜯�Ｖ蛹�笔�摮睃銁�����蝚血�敶枏�銝𠹺���祗憓���賡��祈恕�餃郎摰硺�嚗��憒���㘾�蝝㰘��埝�頧祈�雿枏�蝥䭾迤銝� "OAT-1" �� "OAT-3"嚗偦𧙕�寧����蝥䭾迤銝� "PBP"嚗𥕦楊�祉��墧�瘣餃�雿枏�蝥䭾迤銝� "TLR-2"嚗剹��

�鞾䔮憸塩��: {q}
�𣂼��滚��Ｕ��: {facet}
�𣂼��𨥭oT��𧋦��: 
\"\"\"
{purified_text}
\"\"\"

霂瑞凒�亦��箇��蹱𤜯�Ｗ�����媒oT��𧋦嚗䔶���閬�遙雿訫�雿嗵�閫������箇蒾�� markdown ��扇嚗�"""
                
                corrected = await client.call_llm(repair_prompt, model_pool="premium")
                repaired_text = corrected.replace("<think>", "").replace("</think>", "").strip()
                logger.info(f"�� [AI �冽��䌊�È 撌脤�朞��舐�摮血�霂��撠� '{entity}' �𠰴�蝘穃劂�冽��典��冽��耨甇���")
                break # �冽����誩歇�滚��冽�嚗諹歲�箏�摰硺�敺芰㴓
                
        except Exception as e:
            logger.error(f"�𩤃� �⊿�摰硺� '{entity}' �𠉛�憭梯揖: {e}. 頝唾��⊿���")
            
    return repaired_text

async def purify_single_think(client: APIClient, q: str, planner: str, raw_think: str) -> Tuple[str, Dict[str, Any]]:
    max_retries = 3
    
    THRESHOLD_PURITY = 85
    THRESHOLD_RIGOR = 90
    THRESHOLD_DEPTH = 85
    
    last_scores = {}
    feedback_prompt = ""
    
    stripped_think = pre_strip_engineering_noise(raw_think)
    
    few_shot = FACET_FEW_SHOTS.get(planner, FEW_SHOT_GENERAL)
    system_prompt = get_purify_system_prompt(planner)
    directive = get_system_directive(planner)
    
    for attempt in range(max_retries):
        prompt = f"""{few_shot}

### 蝟餌���誘 (System Directive)嚗�
Please write an extremely raw, high-entropy clinical reasoning thought trace focusing on {directive}.
CRITICAL蝥Ｙ瑪嚗枠ou MUST write in a live EXPLORATORY CoT style. Do NOT write a textbook article or explanation (蝏嘥笆蝳�迫�蹱��蹱����格�蝡䭾�霂湔�銋佗�). 
You MUST include counterfactual checks and at least 1-2 explicit self-questioning markers with a question mark (敹�◆�冽�萘輕銝剝�𥪜��怨秐撠� 1-2 憭�誑 '嚗�' 蝏枏偏���摰墧䔝蝛嗥��殷�憒���𦦵���蘨�臬�銝�...�梹���).
Do NOT output the word 'facet' or the facet name '{planner}' in the text. Output ONLY the purified thought chain.

�桅�: {q}
�笔��萘輕�� (CoT) ��捆:
\"\"\"
{stripped_think}
\"\"\"{feedback_prompt}

霂瑚艇�潭��扳�蝥舫��坔�瘚���辷��湔𦻖颲枏枂�㗇�萘輕�𡁜漲��蒂�芣��鞾䔮�齿�萘�蝥臬��肽���蝔页�"""
        try:
            purified = await client.call_llm(prompt, system_prompt=system_prompt, model_pool="premium")
            purified = purified.replace("<think>", "").replace("</think>", "").strip()
            
            if purified.startswith("```"):
                purified = "\n".join(purified.splitlines()[1:])
            if purified.endswith("```"):
                purified = "\n".join(purified.splitlines()[:-1])
            purified = purified.strip()
            
            # 摰𡁜��拍���膄���隞文��箇蒾
            purified = post_strip_meta_openings(purified)
            
            if is_catastrophic_format_collapse(purified):
                logger.warning(f"   �辶 Attempt {attempt+1} triggered SYNTAX FORMAT COLLAPSE! Local intercepting...")
                scores = {
                    "semantic_purity_score": 0,
                    "medical_rigor_score": 90,
                    "logical_depth_score": 0,
                    "reason": "閫血��拍��澆�撏拇�蝖祆�抒��剝秄蝳�����箔葉畾讠�鈭�𡠺�瑟�憭扳芋�钅��嗵�蝣𤾸艙��"
                }
            elif has_repetition_loop(purified):
                logger.warning(f"   �辶 Attempt {attempt+1} triggered Repetition penalty! Local intercepting...")
                scores = {
                    "semantic_purity_score": 50,
                    "medical_rigor_score": 90,
                    "logical_depth_score": 50,
                    "reason": "璉�瘚见��鞟滲�𡒊���𧋦�𤑳�鈭�香敺芰㴓銝𤾸�霂駁���硔��"
                }
            else:
                scores = await evaluate_purified_think(client, q, planner, raw_think, purified)
            
            last_scores = scores
            
            # �𣞁 �喲睸摰匧�頧祆揢�脩瑪嚗𡁻俈甇Ｘ筑�寞�摮㛖泵撖潸稲���颲�援皞�
            p_score = safe_int(scores.get("semantic_purity_score", 90))
            r_score = safe_int(scores.get("medical_rigor_score", 90))
            d_score = safe_int(scores.get("logical_depth_score", scores.get("logical_coherence_score", 90)))
            reason = str(scores.get("reason", "No reason provided"))
            
            logger.info(f"   �婙� Attempt {attempt+1}: [Purity: {p_score}/100, Rigor: {r_score}/100, Depth: {d_score}/100] | Reason: {reason}")
            
            if p_score >= THRESHOLD_PURITY and r_score >= THRESHOLD_RIGOR and d_score >= THRESHOLD_DEPTH:
                logger.info(f"   �� Quality Gate PASSED on attempt {attempt+1}! Starting academic entity verification & self-healing...")
                purified = await verify_and_repair_academic_entities(client, purified, q, planner)
                
                sim = calculate_similarity(raw_think, purified)
                has_noise = any(kw in purified.lower() for kw in ["json", "schema", "�滩提憯唳�", "敹賜裦", "refs", "�曇停"])
                is_bypass = sim > 0.85 and has_noise
                scores["purity_bypass"] = is_bypass
                
                return purified, scores
            else:
                logger.warning(f"   �� Quality Gate FAILED on attempt {attempt+1}. Generating feedback...")
                
                # �� �箄�銝厩輕�冽��秐蝥舀�摰喳��漤��箏� (De-contaminated Feedback Loop)
                # 銝滚�撠���怨�閫��銝𤾸��� Token ����文�憪贝�霂凋��䂿�憭扳芋�页��脫迫 Token �瑁�瘙⊥�
                feedback_msg = f"\n\n�𣂼�銝�甈⊥�瘣堒�霂閗捶�譍�颲暹��漤�嚗朞祗銋厩滲��摨�={p_score}/100, �餃郎銝亥馬摨�={r_score}/100, �餉�瘛勗漲={d_score}/100����"
                
                if p_score < THRESHOLD_PURITY:
                    feedback_msg += "\n�鞉瓲敹���𡝗�隞歹�雿删��滢�甈∪��亙銁�𡏭祗銋厩滲��摨色�苷�銝滨泵�������窈蝖桐��函�銝箏��刻�韐胯��䌊�嗆��函�銝游�摮行钟畾菔氜嚗𣬚�撖寧�甇Ｘ��𦠜��㛖內隞颱��喃��𨅯���縑�舀糓憒���瑕����腈���𨀣㺭�格糓�血�頞喇�脲��𨀣㺭�桃����甇仿炊��圾�萘���捆����烐絲銝剜𥅾�㗇�摰����龫摮血虜霂��霂瑞凒�亙�憪𧢲�蝥舐硃�������舐��箏�瞍𠉛�����"
                
                if d_score < THRESHOLD_DEPTH:
                    feedback_msg += "\n�鞉瓲敹���𡝗�隞歹�雿删��滢�甈∪��亙銁�𣈯�餉�瘛勗漲�苷�銝滨泵������霂餉絲�亙��臭�蝭�香�輸����蝘烐芦����𤥁晓�抵秩�𦒘髡��窈�踹�撟喲唍�游�嚗�撩�嗅銁�萘輕銝剝�𥪜��� 1-2 憭�誑�頣��萘�撠曄��笔��Ｙ弦�煾䔮嚗�僎雿輻鍂擃睃�摨衣��䭾�頧祆�霂滚��啣𢆡��䔝蝝Ｖ��芣�蝥惩����瘚�膘餈嫘����"
                
                # �𣞁 �寞�銝�嚗𡁜�擐��𡁻��芷����望�嚗𣬚���𤜯�Ｘ��匧虾�質圻�𤑳��剔�銝剜𡠺�瘀���鱏 Token �瑁�撘訫�
                feedback_msg = feedback_msg.replace('[', '��').replace(']', '��')
                feedback_prompt = feedback_msg
                
        except Exception as e:
            logger.error(f"   �𩤃� Error during purification attempt {attempt+1}: {e}")
            
    logger.warning("   �𩤃� Quality Gate Max Retries exceeded. Gracefully falling back to regex heuristic fallback to ensure safety.")
    
    # �𣞁 �喲睸靽桀�嚗𡁜��亙��函� Import ���選��脫迫�曆��唳�隞嗆𥁒��
    try:
        from clean_dataset import clean_think_text
        purified = clean_think_text(raw_think)
    except ImportError:
        logger.error("   �𩤃� Fallback failed: clean_dataset module not found! Using manual strip as safety fallback.")
        purified = post_strip_meta_openings(pre_strip_engineering_noise(raw_think))
        
    sim = calculate_similarity(raw_think, purified)
    has_noise = any(kw in purified.lower() for kw in ["json", "schema", "�滩提憯唳�", "敹賜裦", "refs", "�曇停"])
    is_bypass = sim > 0.85 and has_noise
    
    return purified, last_scores or {
        "semantic_purity_score": 85,
        "medical_rigor_score": 90,
        "logical_depth_score": 85,
        "reason": "Fallback used.",
        "purity_bypass": is_bypass
    }

def update_env_start_line(env_path: Path, start_line: int):
    """
    Dynamically writes the determined starting line number back to the .env file.
    """
    if not env_path.exists():
        return
    with open(env_path, 'r', encoding='utf-8') as f:
        content = f.read()
    
    # Check if PURIFY_START_LINE exists in env
    pattern = re.compile(r"^(\s*PURIFY_START_LINE\s*=).*$", re.MULTILINE)
    if pattern.search(content):
        new_content = pattern.sub(f"\\1{start_line}", content)
    else:
        new_content = content.rstrip() + f"\n\n# �芸𢆡霈曄蔭����𤥁絲憪贝��愧nPURIFY_START_LINE={start_line}\n"
        
    with open(env_path, 'w', encoding='utf-8') as f:
        f.write(new_content)

async def main():
    dataset_path = Path("d:/REN/qa/medical_qa_dataset.jsonl")
    backup_path = Path("d:/REN/qa/medical_qa_dataset_raw.jsonl")
    logs_dir = Path("d:/REN/qa/logs")
    
    # Resolve PURIFY_START_LINE configuration
    purify_start_line = PURIFY_START_LINE
    
    if purify_start_line is None:
        logger.info("�� PURIFY_START_LINE is not set in .env. Scanning all historical logs to auto-detect the maximum processed line...")
        run_files = [
            f for f in logs_dir.glob("purification_run_*.md")
            if re.search(r"purification_run_(?:\[\d+-\d+\]_)?\d{8}_\d{6}\.md", f.name)
        ]
        
        all_processed_lines = []
        for rf in run_files:
            try:
                with open(rf, 'r', encoding='utf-8') as lf:
                    log_content = lf.read()
                lines_in_file = [int(num) for num in re.findall(r"�唳旿��洵\s*(\d+)\s*銵�", log_content)]
                all_processed_lines.extend(lines_in_file)
            except Exception as e:
                logger.warning(f"�𩤃� Failed to parse log file {rf.name}: {e}")
                
        if all_processed_lines:
            max_line = max(all_processed_lines)
            purify_start_line = max_line + 1
            logger.info(f"�㴓 Auto-detected maximum processed line across all logs: {max_line}. Setting PURIFY_START_LINE to: {purify_start_line}")
        else:
            purify_start_line = 1
            logger.info("�𩤃� No processed line numbers found in any historical logs. Setting PURIFY_START_LINE to: 1")
            
        # Write back to .env file
        env_path = Path("d:/REN/qa/.env")
        try:
            update_env_start_line(env_path, purify_start_line)
            logger.info(f"�𠒣 Dynamically updated PURIFY_START_LINE={purify_start_line} in .env file.")
        except Exception as e:
            logger.warning(f"�𩤃� Failed to write back to .env: {e}")
    else:
        logger.info(f"�㴓 Using manually configured PURIFY_START_LINE={purify_start_line} from .env")
    
    if not dataset_path.exists():
        logger.error(f"Dataset file not found: {dataset_path}")
        return
        
    if not backup_path.exists():
        logger.info(f"�� Creating initial raw backup at {backup_path}")
        shutil.copyfile(dataset_path, backup_path)
    else:
        # �叚 �箄�憓鮋��峕郊憭�遢�餉�嚗𡁜銁皜���㵪�隞���啣���𧊋皜�� Raw �唳旿銵諹蕭�惩��笔�隞賣�隞嗆錰撠橘�靽脲��蓥�憭�遢��辣�峕郊�鍦�
        try:
            with open(dataset_path, 'r', encoding='utf-8') as f:
                dataset_lines = f.readlines()
            with open(backup_path, 'r', encoding='utf-8') as f:
                backup_lines = f.readlines()
                
            if len(dataset_lines) > len(backup_lines):
                new_raw_lines = dataset_lines[len(backup_lines):]
                logger.info(f"�� Detected {len(new_raw_lines)} new raw incremental records. Syncing and appending to raw backup...")
                with open(backup_path, 'a', encoding='utf-8') as f:
                    f.writelines(new_raw_lines)
            else:
                logger.info(f"�� Raw backup is fully in sync with current dataset ({len(backup_lines)} lines). No new raw entries to append.")
        except Exception as e:
            logger.warning(f"�𩤃� Failed to sync incremental backup: {e}. Keeping existing backup.")
        
    logs_dir.mkdir(parents=True, exist_ok=True)
    logger.info(f"�� Verified that log folder exists at: {logs_dir}")
    
    client = APIClient()
    logger.info("�� Initializing API Client for LLM Semantic Purifying & QA Judging...")
    
    with open(dataset_path, 'r', encoding='utf-8') as f:
        lines = f.readlines()
        
    logger.info(f"Loaded {len(lines)} dataset records. [Config] PURIFY_LIMIT={PURIFY_LIMIT}, PURIFY_LINES={PURIFY_LINES}. Starting double-check purification...")
    
    sem = asyncio.Semaphore(3)
    
    purified_diff_logs = []
    
    async def process_record(line_idx, line_str, should_purify=True):
        if not line_str.strip():
            return line_str
            
        try:
            data = json.loads(line_str)
            
            # �𣞁 撘箏��亦氖 history 銝� refs 摮埈挾隞亙笆朣𣂼凝靚���臬𢆡閫��嚗���𤩺㺭�桀笆朣鞾俈蝥選�
            data.pop("history", None)
            data.pop("refs", None)
            
            if should_purify:
                q = data.get("Q", "")
                planners = data.get("planners", [])
                
                valid_planners = []
                for p in planners:
                    planner_name = p.get("planner", "")
                    raw_answer = p.get("answer", "")
                    
                    # 3a & 3b. �滨蔭璉�瘚页�蝟餌��𨅯�璅⊥踎�𠰴��典�霂脲芋��
                    TEMPLATE_SIGNATURES = [
                        "閫血�擃睃虾�券俈�垍�",
                        "摰匧��脣鴃韐券�蝑𣇉裦",
                        "銝游�����𨅯�璅⊥踎",
                        "摰匧��行⏛",
                    ]
                    SAFE_BODY_SIGNATURES = [
                        "憿颱艇�潔��桐�蝘穃龫撣��撖�",
                        "銝交聢閫���刻晓�滢�蝳���𦠜��函�瘥鍦��滚�",
                        "�喃�霂亙�摨瑕倮霂Ｖ葉瘨匧���",
                    ]
                    
                    if any(sig in raw_answer for sig in TEMPLATE_SIGNATURES):
                        logger.warning(f"�辶 璉�瘚见�銵� {line_idx+1} ��𢒰 '{planner_name}' ��鉄蝟餌��𨅯�璅⊥踎嚗�歇隞擧㺭�桅�銝剖��歹�")
                        purified_diff_logs.append({
                            "line_number": line_idx + 1,
                            "question": q,
                            "facet": planner_name,
                            "original_think": raw_answer,
                            "purified_think": "[DROPPED: 蝟餌��𨅯�璅⊥踎嚗�歇�娪膄]",
                            "scores": {"semantic_purity_score": 0, "medical_rigor_score": 0, "logical_depth_score": 0, "reason": "蝟餌��𨅯�璅⊥踎嚗屸�璅∪��函���歇�娪膄��"}
                        })
                        continue
                        
                    if any(sig in raw_answer for sig in SAFE_BODY_SIGNATURES):
                        logger.warning(f"�辶 璉�瘚见�銵� {line_idx+1} ��𢒰 '{planner_name}' ��鉄摰匧�摨蠘�璅⊥踎嚗�歇隞擧㺭�桅�銝剖��歹�")
                        purified_diff_logs.append({
                            "line_number": line_idx + 1,
                            "question": q,
                            "facet": planner_name,
                            "original_think": raw_answer,
                            "purified_think": "[DROPPED: 摰匧�摨蠘�璅⊥踎嚗�歇�娪膄]",
                            "scores": {"semantic_purity_score": 0, "medical_rigor_score": 0, "logical_depth_score": 0, "reason": "摰匧�摨蠘�璅⊥踎��歇�娪膄��"}
                        })
                        continue
                    
                    think_match = re.match(r"^\s*<think>([\s\S]*?)</think>([\s\S]*)$", raw_answer)
                    if think_match:
                        raw_think = think_match.group(1).strip()
                        answer_body = think_match.group(2).strip()
                        
                        # �� �𣂼�撟嗅�蝳� <facet = xxx> ��倌嚗屸��滚�雿靝蛹蝟餌��芸ㄟ撟脫贋 LLM ���蝥臬�鋆�ế���隡�
                        facet_match = re.match(r"^\s*(<facet\s*=\s*[^>]+>)\s*([\s\S]*)$", raw_think)
                        if facet_match:
                            facet_tag = facet_match.group(1).strip()
                            actual_raw_think = facet_match.group(2).strip()
                        else:
                            facet_tag = f"<facet = {planner_name}>"
                            actual_raw_think = raw_think
                        
                        async with sem:
                            logger.info(f"�� Processing Record {line_idx+1}: Q='{q[:12]}...' | Facet='{planner_name}'")
                            purified_think, score_dict = await purify_single_think(client, q, planner_name, actual_raw_think)
                        
                        # �叚 皜��摰峕��𠬍�撠���� of <facet = xxx> ��倌�齿鰵�潭𦻖靽萘��� think �㛖����漤�嚗𣬚＆靽脲㺭�桅��澆�����湔��
                        p["answer"] = f"<think>\n{facet_tag}\n{purified_think}\n</think>\n{answer_body}"
                        
                        purified_diff_logs.append({
                            "line_number": line_idx + 1,
                            "question": q,
                            "facet": planner_name,
                            "original_think": raw_think,
                            "purified_think": purified_think,
                            "scores": score_dict
                        })
                        valid_planners.append(p)
                    else:
                        valid_planners.append(p)
                data["planners"] = valid_planners
            
            return json.dumps(data, ensure_ascii=False) + "\n"
        except Exception as e:
            logger.error(f"�� Error processing line {line_idx+1}: {e}")
            return line_str
            
    purify_counter = 0
    tasks = []
    for i, line in enumerate(lines):
        line_num = i + 1
        should_purify = True
        
        if PURIFY_LINES:
            if line_num not in PURIFY_LINES:
                should_purify = False
                
        # Apply starting line filter
        if purify_start_line is not None:
            if line_num < purify_start_line:
                should_purify = False
                
        if should_purify:
            try:
                data = json.loads(line)
                has_think = any(
                    bool(re.match(r"^\s*<think>([\s\S]*?)</think>", p.get("answer", "")))
                    for p in data.get("planners", [])
                )
                if has_think:
                    if PURIFY_LIMIT is not None:
                        if purify_counter < PURIFY_LIMIT:
                            purify_counter += 1
                        else:
                            should_purify = False
                else:
                    should_purify = False
            except Exception:
                should_purify = False
        
        tasks.append(process_record(i, line, should_purify))
        
    processed_results = await asyncio.gather(*tasks)
    
    with open(dataset_path, 'w', encoding='utf-8') as f:
        f.writelines(processed_results)
        
    # Group diff logs by line_number to keep facets organized by QA
    from collections import defaultdict
    grouped_logs = defaultdict(list)
    for item in purified_diff_logs:
        grouped_logs[item["line_number"]].append(item)
        
    unique_qas_count = len(grouped_logs)
    
    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    if purified_diff_logs:
        sorted_lines = sorted(grouped_logs.keys())
        line_range = f"[{sorted_lines[0]}-{sorted_lines[-1]}]_"
    else:
        line_range = ""
        
    diff_log_path = logs_dir / f"purification_run_{line_range}{timestamp}.md"
    latest_log_path = logs_dir / "purification_run.md"
    logger.info(f"�� Writing detailed diff logs to: {diff_log_path}...")
    
    with open(diff_log_path, 'w', encoding='utf-8') as lf:
        lf.write("# �征 �餌��桃��萘輕�暹�蝥臬��� Diff 撖寧�撌桀��亙�\n\n")
        lf.write("�砍榆撘�𥁒�𡃏祕蝏�扇敶蓥�撖寞㺭�桅� `medical_qa_dataset.jsonl` �扯�憭扳芋�𧢲�萘輕�暹�蝥臬��硋��𡒊�撖寞�靽⊥�嚗���怠�銝芾�閫垍�鋆�ế霂��霂行���n\n")
        lf.write(f"- **撌脫�蝥臬��碶蜓�桅��餅㺭 (Total QAs purified)**: {unique_qas_count} 銝歿n")
        lf.write(f"- **摰峕��鞟滲���𤥁�閫埝�餅㺭 (Total facets purified)**: {len(purified_diff_logs)} 銝歿n\n")
        lf.write("## �� �鞟滲�亙�霂行��𡑒”\n\n")
        
        sorted_lines = sorted(grouped_logs.keys())
        for q_idx, line_num in enumerate(sorted_lines):
            items_for_qa = sorted(grouped_logs[line_num], key=lambda x: x["facet"])
            question = items_for_qa[0]["question"]
            
            lf.write(f"## �� [QA-{q_idx+1}] (�唳旿��洵 {line_num} 銵�) | 銝駁䔮憸�: `{question}`\n")
            lf.write(f"*   **霂仿䔮憸睃��鞉�蝥臬��𤥁�閫埝�餅㺭 (Total facets purified for this QA)**: **{len(items_for_qa)}** 銝歿n\n")
            
            for f_idx, item in enumerate(items_for_qa):
                lf.write(f"### �� 閫�� [{f_idx+1}]: 銝游�閫��: **{item['facet']}**\n")
                
                sc = item["scores"]
                lf.write(f"*   **韐冽�鋆�ế�誩�霂�� (Quality Scores)**: \n")
                lf.write(f"    - �叚 霂凋�蝥臬�摨� (Semantic Purity): **{sc.get('semantic_purity_score', 'N/A')}/100**\n")
                lf.write(f"    - �征 �餃郎銝亥馬摨� (Medical Rigor): **{sc.get('medical_rigor_score', 'N/A')}/100**\n")
                lf.write(f"    - �� �餉�瘛勗漲銝擧�萘輕�� (Logical Depth): **{sc.get('logical_depth_score', sc.get('logical_coherence_score', 'N/A'))}/100**\n")
                lf.write(f"    - �俥 鋆�ế霂�恣霂行� (Judge Reason): *\"{sc.get('reason', 'N/A')}\"*\n")
                if sc.get("purity_bypass"):
                    lf.write("    - �𩤃� **蝏閗�霅血�**: 璉�瘚见�憭扳芋�钅�摨行鼧韐嘥�����㗇��坔極蝔见��橘�鋡怠ế銝粹俈�瑁�撟餉�蝏閗�嚗�n\n")
                else:
                    lf.write("\n")
                
                lf.write("#### �� �鞟滲�滚�撖寞� (Before & After Contrast)\n\n")
                lf.write("````carousel\n")
                lf.write("```markdown\n")
                lf.write("�笔��萘輕�� (�怠極蝔衤�璉�蝝Ｗ臁憯�)\n")
                lf.write(item['original_think'])
                lf.write("\n```\n")
                lf.write("\n")
                lf.write("```markdown\n")
                lf.write("�鞟滲���硋���滲���萘輕�閱n")
                lf.write(item['purified_think'])
                lf.write("\n```\n")
                lf.write("````\n\n")
                
            lf.write("---\n\n")
            
    try:
        shutil.copyfile(diff_log_path, latest_log_path)
        logger.info(f"�� Synced latest log copy to standard path: {latest_log_path}")
    except Exception as e:
        logger.warning(f"�𩤃� Failed to sync standard log copy: {e}")
            
    bypass_list = [item for item in purified_diff_logs if item["scores"].get("purity_bypass")]
    if bypass_list:
        logger.warning("\n" + "="*60)
        logger.warning("�𩤃� [WARNING] �𤑳緵憭扳芋�见��券�摨行鼧韐苷��㗇��坔極蝔见��嗵�蝏閗�餈肽� (Purity Bypass Detected):")
        for idx, item in enumerate(bypass_list):
            logger.warning(f"  [{idx+1}] 銵�噡: {item['line_number']} | 閫��: {item['facet']} | �桅�: {item['question'][:20]}...")
            logger.warning("      - 霂交�蝥航���◤撘箏�撽喳�撟嗅�銝箔�颲暹�嚗�遣霈株�銵䔶犖撌亦＆霈斗��滢����潘�")
        logger.warning("="*60 + "\n")
    else:
        logger.info("\n�� ���㗇�萘輕�曉�撌脫��笔��鞾�韐券��鞟滲���吔��芸��唬遙雿閧�餈��閫��\n")
            
    # �𠒣 �詨�靽桀�嚗朞䌊�券�坿�韏瑕�銵�噡嚗屸��滢�銝�甈∟��寥�憭滩�銵�歇���𤥁�
    if purified_diff_logs and not PURIFY_LINES:
        max_processed_line = max(grouped_logs.keys())
        next_start_line = max_processed_line + 1
        env_path = Path("d:/REN/qa/.env")
        try:
            update_env_start_line(env_path, next_start_line)
            logger.info(f"�𠒣 �芸𢆡�坿�銝衤�甈∪��𤥁絲憪贝��瘀�PURIFY_START_LINE={next_start_line} 撟嗅歇�坔� .env ��辣��")
        except Exception as e:
            logger.warning(f"�𩤃� �芸𢆡�坿�韏瑕�銵�噡�坔� .env 憭梯揖: {e}")

    logger.info("=========================================")
    logger.info("�� LLM Semantic Purification & Quality Gate Validation Complete!")
    logger.info(f"�𠒣 Purified dataset saved successfully to: {dataset_path}")
    logger.info(f"�� Markdown diff run logs saved to: {diff_log_path}")
    logger.info("=========================================")

if __name__ == "__main__":
    asyncio.run(main())